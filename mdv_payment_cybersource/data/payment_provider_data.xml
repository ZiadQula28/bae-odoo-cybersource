<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_provider_mdv_cybersource" model="payment.provider">
        <field name="name">CyberSource</field>
        <field name="code">mdv_cybersource</field>
        <field name="sequence">5</field>
        <field name="image_128" type="base64" file="mdv_payment_cybersource/static/description/icon.png"/>
        <field name="module_id" ref="base.module_mdv_payment_cybersource"/>
        <field name="inline_form_view_id" ref="inline_form"/>
        <field name="allow_tokenization" eval="True"/>
        <field name="state">disabled</field>
        <field name="payment_method_ids"
               eval="[Command.set([ref('payment.payment_method_card')])]"/>
    </record>

</odoo>
